// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  role_id   Int    @id @default(autoincrement())
  role_name String @unique @db.VarChar(50)

  employees Employee[]
}

model Employee {
  employee_id Int    @id @default(autoincrement())
  fullname    String @db.VarChar(100)
  username    String @unique @db.VarChar(50)
  password    String @db.VarChar(255)
  email       String @db.VarChar(100)
  phone       String @db.VarChar(15)
  role_id     Int

  role           Role            @relation(fields: [role_id], references: [role_id])
  jobs           Job[]
  productionLogs ProductionLog[]
}

model Customer {
  customer_id    Int    @id @default(autoincrement())
  customer_code  String @unique @db.VarChar(20)
  fullname       String @db.VarChar(100)
  email          String @db.VarChar(100)
  phone          String @db.VarChar(15)
  address_detail String @db.Text

  jobs Job[]
  shipments Shipment[]
}

model Job {
  job_id            Int      @id @default(autoincrement())
  job_number        String   @unique @db.VarChar(20)
  created_date      DateTime @db.Date
  end_date          DateTime @db.Date
  customer_id       Int
  total_quantity    Int
  clothing_type     String   @db.VarChar(50)
  type_of_fabric    String   @db.VarChar(50)
  employee_id       Int
  delivery_location String   @db.VarChar(255)

  customer Customer @relation(fields: [customer_id], references: [customer_id])
  employee Employee @relation(fields: [employee_id], references: [employee_id])

  jobSteps       JobStep[]
  plannings      Planning[]
  productionLogs ProductionLog[]
  shipments      Shipment[]
  productionSchedules ProductionSchedule[]
}

model Step {
  step_id       Int    @id @default(autoincrement())
  step_name     String @unique @db.VarChar(50)
  standard_time Int
  priority      Int    @default(1)

  jobSteps JobStep[]
  capacities StepCapacity[]
}

model JobStep {
  job_step_id Int     @id @default(autoincrement())
  job_id      Int
  step_id     Int
  minutes_per_unit Int?


  job  Job  @relation(fields: [job_id], references: [job_id])
  step Step @relation(fields: [step_id], references: [step_id])

  plannings      Planning[]
  productionLogs ProductionLog[]
  shipmentItems       ShipmentItem[]
  productionSchedules ProductionSchedule[]


  @@unique([job_id, step_id])
}

model Planning {
  planning_id      Int      @id @default(autoincrement())
  job_id           Int
  job_step_id      Int
  planned_date     DateTime @db.Date
  planned_quantity Int

  job     Job    @relation(fields: [job_id], references: [job_id])
  jobStep JobStep @relation(fields: [job_step_id], references: [job_step_id])

  @@unique([job_id, job_step_id, planned_date])
}

model ProductionLog {
  log_id       Int      @id @default(autoincrement())
  job_id       Int?
  job_step_id  Int
  log_date     DateTime @db.Date
  dateline_date DateTime @db.Date 
  quantity     Int
  employee_id  Int
  

  job       Job?      @relation(fields: [job_id], references: [job_id])
  jobStep   JobStep   @relation(fields: [job_step_id], references: [job_step_id])
  employee  Employee  @relation(fields: [employee_id], references: [employee_id])
}






model TransportType {
  transport_type_id Int    @id @default(autoincrement())
  transport_name    String @unique @db.VarChar(50)

  shipments Shipment[] @relation("TransportToShipment")
}

model ShipmentStatus {
  status_id   Int    @id @default(autoincrement())
  status_name String @unique @db.VarChar(50)

  shipments Shipment[] @relation("StatusToShipment")
}

model Shipment {
  shipment_id       Int      @id @default(autoincrement())
  shipment_numbar   String   @unique @db.VarChar(20)
  customer_id       Int
  job_id            Int
  transport_type_id Int
  status_id         Int
  departure_date    DateTime @db.Date
  arrival_date      DateTime @db.Date
  actual_delivery_date DateTime? @db.Date
  note              String?  @db.Text
  total_quantity    Int      @default(0)

  customer Customer @relation(fields: [customer_id], references: [customer_id])
  job      Job      @relation(fields: [job_id], references: [job_id])

  transportType TransportType @relation("TransportToShipment", fields: [transport_type_id], references: [transport_type_id])

  status ShipmentStatus @relation("StatusToShipment", fields: [status_id], references: [status_id])

  shipmentItems ShipmentItem[] @relation("ShipmentToItem")
}

model ShipmentItem {
  shipment_item_id Int @id @default(autoincrement())
  shipment_id      Int
  job_step_id      Int
  quantity         Int

  shipment Shipment @relation("ShipmentToItem", fields: [shipment_id], references: [shipment_id])

  jobStep JobStep @relation(fields: [job_step_id], references: [job_step_id])
}

model StepCapacity {
  capacity_id  Int      @id @default(autoincrement())
  step_id      Int
  worker_count Int
  work_date    DateTime @db.Date

  step Step @relation(fields: [step_id], references: [step_id])
}

model ProductionSchedule {
  schedule_id Int @id @default(autoincrement())

  job_id      Int
  job_step_id Int

  schedule_date DateTime @db.Date
  planned_qty   Int

  jobStep JobStep @relation(fields: [job_step_id], references: [job_step_id])
  job     Job     @relation(fields: [job_id], references: [job_id])
}

model WorkCalendar {
  calendar_id Int      @id @default(autoincrement())
  work_date   DateTime @db.Date
  work_hour   Int

  @@unique([work_date])
}
